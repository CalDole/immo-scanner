# Copy to .streamlit/secrets.toml and fill in Neon. secrets.toml is gitignored.
# On Streamlit Community Cloud, paste this same TOML into Settings → Secrets.
# Leave both blocks empty to use IMMO_DATABASE_URL from .env.
#
# postgresql:// and postgres:// are accepted; the app rewrites them to
# postgresql+psycopg:// (psycopg 3, not psycopg2).
# DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL = ""

# Used only when DATABASE_URL is empty. A host other than localhost gets sslmode=require.
[postgres]
host = ""
username = ""
password = ""
database = ""
port = 5432
