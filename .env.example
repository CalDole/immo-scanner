# --- Docker Compose ---------------------------------------------------------
POSTGRES_USER=immo
POSTGRES_PASSWORD=immo
POSTGRES_DB=immo
POSTGRES_PORT=5432
METABASE_PORT=3000
# How the Metabase container reaches PostgreSQL: host.docker.internal for a local
# install, "db" with `docker compose --profile docker-db`. Set both variables.
METABASE_DB_HOST=host.docker.internal
IMMO_METABASE_DB_HOST=host.docker.internal

# --- Python app (prefix IMMO_) ------------------------------------------------
IMMO_DATABASE_URL=postgresql+psycopg://immo:immo@localhost:5432/immo

# Commute destinations: addresses (geocoded once). The first workplace can also
# be set with explicit coordinates, which then override IMMO_WORKPLACE_ADDRESS.
IMMO_WORKPLACE_ADDRESS=Bismarckstraße 71, 10627 Berlin
IMMO_WORKPLACE2_ADDRESS=Oranienburger Straße 70, 10117 Berlin, Germany
IMMO_CITYCENTER_ADDRESS=Europaplatz 1, 10557 Berlin
# IMMO_WORKPLACE_LAT=52.5219
# IMMO_WORKPLACE_LON=13.4132

# Local Nominatim started by `docker compose up -d`. Use
# https://nominatim.openstreetmap.org only if you are not running the container;
# that instance allows one request per second and requires IMMO_CONTACT_EMAIL.
IMMO_NOMINATIM_URL=http://localhost:8080
NOMINATIM_PORT=8080

# Required when IMMO_NOMINATIM_URL is the public instance
# (https://operations.osmfoundation.org/policies/nominatim/)
IMMO_CONTACT_EMAIL=you@example.com

# Search criteria for all crawlers (leave empty for no limit). They are added to the
# portal and ThinkImmo searches where supported and applied to every listing before saving.
IMMO_MIN_ROOMS=
IMMO_MIN_LIVING_AREA=
IMMO_MIN_PRICE=
IMMO_MAX_PRICE=
# Skip flats sold with a tenant ("vermietet"): true or false
IMMO_EXCLUDE_RENTED=false

# Photo copies of ImmoScout24 exposés: large (1106x830 WebP), original or none
IMMO_IS24_PHOTO_SIZE=large

# Photo copies of Neubaukompass flats: large (950x1200), original or none
IMMO_NEUBAUKOMPASS_PHOTO_SIZE=large

# Photo copies of Kleinanzeigen ads: large or none
IMMO_KLEINANZEIGEN_PHOTO_SIZE=large

# Crawling behaviour
IMMO_CRAWL_MAX_PAGES=20
IMMO_CRAWL_DELAY_MIN=2.0
IMMO_CRAWL_DELAY_MAX=5.0
# Keep the browser visible for ImmoScout24 so you can solve a captcha if one appears.
IMMO_BROWSER_HEADLESS=false

# Metabase admin used by `immo metabase-setup`
IMMO_METABASE_URL=http://localhost:3000
IMMO_METABASE_ADMIN_EMAIL=you@example.com
IMMO_METABASE_ADMIN_PASSWORD=change-me-please-1
